<%
  links = []
  current_tab ||= ""
  [
    ["Sources", admin_metrics_path],
    ["Languages", admin_metrics_languages_path],
    ["Translators", admin_metrics_translators_path],
		["Top Translators", admin_metrics_top_translators_path],
    ["Charts", admin_metrics_charts_path],
	].each do |link|
      if current_page?(link.last)
        current_tab = link.first if current_tab.blank?
        links << link.first
      else
        links << link_to(link.first, link.last)
      end
   end
%>

<div class="section_title">
  <span style="font-size:12px; float:right; padding-top:5px;">
    <%=links.join(" | ").html_safe%>
  </span>
  <%=current_tab %>
</div>

