<%= render :partial => "/tr8n/admin/common/header" %>
<%= render :partial => "tabs" %>
<%= tr8n_will_filter(@metrics) %>
<%=link_to("Calculate daily metrics", admin_language_calculate_metrics_path, :confirm => "Are you sure you want to run this operation?")%>
 |
<%=link_to("Calculate total metrics", admin_language_calculate_total_metrics_path, :confirm => "Are you sure you want to run this operation?")%>
<br>

<%= will_filter_table_tag(@metrics, :columns => [
    :id,
    [:language_id, lambda{|metric| metric.language.english_name}],
    :type, :metric_date, :user_count, :translator_count,
    :translation_count, :key_count, :locked_key_count
  ])
%>

<%= render :partial => "/tr8n/admin/common/footer" %>
