<% form_tag("", :id => "keys_form", :method => :get) do %>
  <%=hidden_field_tag(:source_id, @source.id) %>
  <%=hidden_field_tag(:mode, params[:mode]) %>
  <div style="border:1px solid #ccc;padding:10px;background:#eee;margin-top:10px;margin-bottom:10px;">
    <%= text_field_tag(:q, params[:q], :style => "width:88%", :placeholder => "Search for specific keys within this source") %>
    <%= link_to_function("<span>#{tra("Search")}</span>", "Tr8n.Effects.submit('keys_form');", :class => "tr8n_grey_button tr8n_pcb") %>
    <%= link_to_function("<span>#{tra("Clear")}</span>", "Tr8n.element('q').value = '';Tr8n.Effects.submit('keys_form');", :class => "tr8n_grey_button tr8n_pcb") %>
  </div>

  <%= will_filter_table_tag(@results, :columns => [
    [:checkbox, :keys],
    [:id, lambda{|key|
      link_to(key.id, admin_translation_key_view_path(key_id: key.id))
    }],
    [:label, lambda{|key|
      html = key.label
      html << '<div style="color:grey; font-size:10px; padding-top:3px;">'
      html << key.description.to_s
      html << '</div>'
    }],
    [:translation_count, lambda{|key| link_to(key.translation_count || 0, admin_translation_key_path(key_id: key.id, mode: :translations)), 'padding:5px;text-align:right;' }],
    [:created_at, lambda{|key| key.created_at}, 'padding:5px;text-align:right;'],
    [:actions, lambda{|key|
      html = []
      html << link_to_function("Update", "tr8nLightbox.show('#{admin_translation_key_lb_update_path(key_id: key.id)}', {'height':450})")
      html << link_to("Delete", admin_translation_key_delete_path(key_id: key.id), {:confirm => "Are you sure you want to delete this key?"})
      html.join(' | ')
    }, 'padding:5px;text-align:right;white-space:nowrap;']
  ]) %>

<%= will_filter_actions_bar_tag(@results, [
  ['Remove From Source', 'removeSelectedKeysFromSource()'],
  ['Merge Selected Keys', 'mergeSelectedKeys()'],
  ['Delete Selected Keys', 'deleteSelectedKeys()'],
  ['Add To Another Source', 'addSelectedKeysToSource()'],
]) %>

<%= javascript_tag(nonce: true) do %>
  function getSelectedKeyIds() {
    var i=0;
    var checkbox = Tr8n.element('wf_check_' + i);
    var keys = [];
    while (checkbox) {
      if (checkbox.checked) {
        keys.push(checkbox.value);
      }
      checkbox = Tr8n.element('wf_check_' + (++i));
    }
    return keys;
  }

  function removeSelectedKeysFromSource() {
    if (!confirm('Make sure the keys are removed from the actual source code. Otherwise they will reappear here again. \nAre you sure you want to remove selected keys from this source?'))
       return;
    Tr8n.element('keys_form').action = "<%= admin_applications_remove_keys_from_source_path %>";
    Tr8n.element('keys_form').submit();
  }

  function mergeSelectedKeys() {
    var keys = getSelectedKeyIds();
    if (keys.length < 2) {
      alert('At least two keys must be selected.');
      return;
    }
    tr8nLightbox.show('<%= admin_translation_key_lb_merge_path %>?keys=' + keys, {height:350});
  }

  function deleteSelectedKeys() {
    if (!confirm('Are you sure you want to delete all selected keys?'))
       return;
    Tr8n.element('keys_form').action = "<%= admin_translation_key_delete_path %>";
    Tr8n.element('keys_form').submit();
  }

  function addSelectedKeysToSource() {
    var keys = getSelectedKeyIds();
    if (keys.length == 0) {
      alert('At least one key must be selected.');
      return;
    }
    tr8nLightbox.show('<%= admin_translation_key_lb_add_to_source_path %>?keys=' + keys, {height:350});
  }
<% end %>
