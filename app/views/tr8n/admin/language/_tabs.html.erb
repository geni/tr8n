<%
  links = []
  current_tab ||= ''
  [ ['Languages', admin_language_path],
    ['Users', admin_language_users_path],
    ['Context Rules', admin_language_rules_path],
    ['Cases', admin_language_cases_path],
    ['Case Rules', admin_language_case_rules_path],
    ['Case Exceptions', admin_language_case_values_path]
  ].each do |link|
      if current_page?(link.last)
        current_tab = link.first if current_tab.blank?
        links << link.first
      else
        links << link_to(link.first, link.last)
      end
   end
%>

<div class="section_title">
  <span style="font-size:12px; float:right; padding-top:5px;">
    <%= links.join(" | ").html_safe %>
  </span>
  <%= current_tab %>
</div>

