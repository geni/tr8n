<%= render :partial => "/tr8n/admin/common/header" %>
<%= render :partial => "tabs" %>
<%= tr8n_will_filter(@case_values.results) %>

<% form_tag("", :id => "values_form") do %>
  <%= will_filter_table_tag(@case_values, :columns => [
    [:language_id, lambda{|lcase|
      if lcase.language
        link_to(lcase.language.english_name, admin_language_view_path(:lang_id => lcase.language.id))
      else
         "Deleted Language"
      end
    }], :keyword, :map, :reported,
    [:translator_id, lambda{|lcase|
      if lcase.translator
        link_to(lcase.translator.name, admin_translator_view_path(:translator_id => lcase.translator.id))
      else
        "System Generated"
      end
    }], :created_at
   ]) %>
<% end %>

<%= render :partial => "/tr8n/admin/common/footer" %>
