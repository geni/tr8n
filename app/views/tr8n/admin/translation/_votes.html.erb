<% form_tag("", :id => "votes_form", :method => :post) do %>
  <%= will_filter_table_tag(@votes, :columns => [
    [:checkbox, :votes],
    [:translator_id, lambda{|vote|
      if vote.translator
        link_to(vote.translator.name, admin_translator_view_path(translator_id: vote.translator.id))
      else
        "Unknown"
      end
    }],
    [:vote, lambda{|vote|
      html = []
      if vote.vote == 1
        html << "<span style='color:green'>"
      else
        html << "<span style='color:red'>"
      end
      html << vote.vote
      html << "</span>"
      html.join("")
    }, 'text-align:right;'],
    [:actions, lambda{|vote|
      html = []
      html << link_to("Delete", admin_translation_delete_vote_path(vote_id: vote.id), {:confirm => "Are you sure you want to delete this vote?"})
      html.join(' | ')
    }, 'text-align:right;white-space:nowrap;']
  ]) %>
<% end %>

<%= will_filter_actions_bar_tag(@votes, [
  ['Delete Selected Votes', 'deleteSelectedVotes()']
]) %>

<%= javascript_tag(nonce: true) do %>
  function deleteSelectedVotes() {
    if (!confirm('Are you sure you want to run this operation?'))
       return;
    Tr8n.element('votes_form').action = "<%= admin_translation_delete_vote_path %>";
    Tr8n.element('votes_form').submit();
  }
<% end %>
