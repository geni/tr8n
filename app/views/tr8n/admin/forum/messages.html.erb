<%= render :partial => "/tr8n/admin/common/header" %>
<%= render :partial => "tabs" %>
<%= tr8n_will_filter(@messages.results) %>

<% form_tag("", :id => "topics_form") do %>
  <%= will_filter_table_tag(@messages, :columns => [:created_at,
    [:language_id, lambda{|message|
      if message.language
        link_to(message.language.english_name, admin_language_view_path(lang_id: message.language.id))
      else
         "Deleted Language"
      end
    }],

    [:translator_id, lambda{|message|
      if message.translator
        link_to(message.translator.name, admin_translator_view_path(translator_id: message.translator.id))
      else
         "Deleted Translator"
      end
    }],

    :message,

    [:actions, lambda{|message|
        actions = []
        actions << link_to("Delete", admin_forum_delete_message_path(msg_id: message.id), {confirm: "Are you sure you want to delete this message?"})
        actions.join(" | ")
    }, 'white-space: nowrap']
  ]) %>
<% end %>

<%= render :partial => "/tr8n/admin/common/footer" %>
