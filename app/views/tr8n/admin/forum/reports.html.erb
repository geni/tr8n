<%= render :partial => "/tr8n/admin/common/header" %>
<%= render :partial => "tabs" %>
<%= tr8n_will_filter(@reports) %>

<% form_tag("", :id => "reports_form") do %>
  <%= will_filter_table_tag(@reports, :columns => [:created_at,
    [:language_id, lambda{|report|
      if report.language
        link_to(report.language.english_name, admin_language_view_path(lang_id: report.language.id))
      else
         "Deleted Language"
      end
    }],

    [:translator_id, lambda{|report|
      if report.translator
        link_to(report.translator.name, admin_translator_view_path(translator_id: report.translator.id))
      else
         "Deleted Translator"
      end
    }],

    :reason,

    [:author, lambda{|report|
      if report.message and report.message.translator
        link_to(report.message.translator.name, admin_translator_view_path(translator_id: report.message.translator.id))
      else
         "Deleted Message"
      end
    }],

    [:language_forum_message_id, lambda{|report|
      if report.message
        report.message.toHTML
      else
         "Deleted Message"
      end
    }],

    [:actions, lambda{|report|
        actions = []
        actions << link_to("Delete Message", admin_forum_delete_message_path(msg_id: report.message.id), {confirm: "Are you sure you want to delete this message?"}) if report.message
        actions << link_to("Delete Report", admin_forum_delete_report_path(report_id: report.id), {confirm: "Are you sure you want to delete this report?"})
        actions.join(" | ")
    }, 'white-space: nowrap']
  ]) %>
<% end %>

<%= render :partial => "/tr8n/admin/common/footer" %>
