<%= render :partial => "/tr8n/admin/common/header" %>
<%= render :partial => "tabs" %>
<%= tr8n_will_filter(@keys.results) %>

<!--
<#%=link_to_function("Import Translation Keys", "tr8nLightbox.show('#{admin_translation_key_lb_import_path}', {'height':280})") %>
 |
-->
<%=link_to_function("Reset Verification Flags", "resetVerificationFlags()")%>
 |
<%=link_to_function("Update Translation Counts", 'updateTranslationCounts()')%>
<br>

<% form_tag("", :id => "keys_form") do %>
	<%= will_filter_table_tag(@keys, :columns => [
	  [:checkbox, :keys],
	  [:label, lambda{|key|
	    html = link_to(key.label, :action => :view, :key_id => key.id)
	    html << '<div style="color:grey; font-size:10px;">'
	    html << key.description.to_s
	    html << '</div>'
	  }],
    :locale,
    [:admin, lambda{|key| key.admin}, 'padding:5px;text-align:right;'],
    [:level, lambda{|key| key.level}, 'padding:5px;text-align:right;'],
	  [:translation_count, lambda{|key| link_to(key.translation_count || 0, admin_translation_path(:wf_c0 => 'translation_key_id', :wf_o0 => 'is', :wf_v0_0 => key.id))}, 'padding:5px;text-align:right;'],
	  [:created_at, lambda{|key| key.created_at}, 'padding:5px;text-align:right;'],
	  [:verified_at, lambda{|key| key.verified_at}, 'padding:5px;text-align:right;'],
	  [:actions, lambda{|key|
	    html = []
	    html << link_to_function("Update", "tr8nLightbox.show('#{admin_translation_key_lb_update_path(:key_id => key.id)}', {'height':450})")
	    html << link_to("Delete", admin_translation_key_delete_path(:key_id => key.id), {:confirm => "Are you sure you want to delete this key?"})
	    html.join(' | ')
	  }, 'padding:5px;text-align:right;white-space:nowrap;']
	]) %>
<% end %>

<%= will_filter_actions_bar_tag(@keys, [
  ['Merge Selected Keys', 'mergeSelectedKeys()'],
  ['Delete Selected Keys', 'deleteSelectedKeys()'],
  ['Associate With Source', 'addSelectedKeysToSource()'],
]) %>

<%= render :partial => "/tr8n/admin/common/footer" %>

<%= javascript_tag(nonce: true) do %>
  function getSelectedKeyIds() {
    var i=0;
    var checkbox = Tr8n.element('wf_check_' + i);
    var keys = [];
    while (checkbox) {
      if (checkbox.checked) {
        keys.push(checkbox.value);
      }
      checkbox = Tr8n.element('wf_check_' + (++i));
    }
    return keys;
  }

	function mergeSelectedKeys() {
		var keys = getSelectedKeyIds();
		if (keys.length < 2) {
			alert('At least two keys must be selected.');
			return;
		}
		tr8nLightbox.show('<%= admin_translation_key_lb_merge_path %>?keys=' + keys, {height:350});
	}

  function deleteSelectedKeys() {
    if (!confirm('Are you sure you want to delete all selected keys?'))
       return;
    Tr8n.element('keys_form').action = "<%= admin_translation_key_delete_path %>";
    Tr8n.element('keys_form').submit();
  }

  function resetVerificationFlags() {
    if (!confirm('Are you sure you want to run this operation?'))
       return;
    location = "<%= admin_translation_key_reset_verification_flags_path %>"
  }

  function updateTranslationCounts() {
    if (!confirm('Are you sure you want to run this operation?'))
       return;
    location = "<%= admin_translation_key_update_translation_counts_path %>"
  }

  function addSelectedKeysToSource() {
    var keys = getSelectedKeyIds();
    if (keys.length == 0) {
      alert('At least one key must be selected.');
      return;
    }
    tr8nLightbox.show('<%= admin_translation_key_lb_add_to_source_path %>?keys=' + keys, {height:350});
  }
<% end %>
