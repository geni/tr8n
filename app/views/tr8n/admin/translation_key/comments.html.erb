<%= render :partial => "/tr8n/admin/common/header" %>
<%= render :partial => "tabs" %>
<%= tr8n_will_filter(@comments.results) %>

<% form_tag("", :id => "comments_form") do %>
  <%= will_filter_table_tag(@comments, :columns => [
    [:checkbox, :comments],
    [:language_id, lambda{|comment|
      if comment.language
        link_to(comment.language.english_name, admin_language_view_path(:lang_id => comment.language.id))
      else
         "Deleted Language"
      end
    }],
    [:translator_id, lambda{|comment|
      if comment.translator
        link_to(comment.translator.name, admin_translator_view_path(:translator_id => comment.translator.id))
      else
         "Deleted Translator"
      end
    }],
    [:translation_key_id, lambda{|comment|
      html = link_to(comment.key.label[0..30], :action => :view, :key_id => comment.key.id)
      html << "..." if comment.key.label.length > 30
      html
    }],
    [:message, lambda{|comment|
      comment.toHTML
    }], :created_at,
    [:actions, lambda{|comment|
      link_to("Delete", admin_translator_delete_comment_path(:comment_id => comment.id), {:method => :post, :confirm => "Are you sure you want to delete this comment?"})
    }, 'padding:5px;text-align:right;white-space:nowrap;']
  ]) %>
<% end %>

<%= will_filter_actions_bar_tag(@keys, [
  ['Delete Selected Comments', 'deleteSelectedComments()']
]) %>

<%= render :partial => "/tr8n/admin/common/footer" %>

<%= javascript_tag(nonce: true) do %>
  function deleteSelectedComments() {
    if (!confirm('Are you sure you want to run this operation?'))
       return;
    Tr8n.element('comments_form').action = "<%= admin_translator_delete_comment_path %>";
    Tr8n.element('comments_form').submit();
  }
<% end %>
