<%
  links = []
  current_tab ||= ""
  [["Translators", admin_translator_path],
   ["Following", admin_translator_following_path],
   ["Reports", admin_translator_reports_path],
   ["Log", admin_translator_log_path],
   ["Ip Locations", admin_translator_ip_locations_path]
  ].each do |link|
      if current_page?(link.last)
        current_tab = link.first if current_tab.blank?
        links << link.first
      else
        links << link_to(link.first, link.last)
      end
	 end
%>

<div class="section_title">
	<span style="font-size:12px; float:right; padding-top:5px;">
	  <%= links.join(" | ").html_safe %>
	</span>
  <%= current_tab %>
</div>

