<table class='wf_values_table' cellspacing='0px' cellpadding='0px'>
	<tr>
    <td width='49%'>
    	<input type='text' style='width:99%;' class='wf_input' name='wf_v<%=index%>_0' id='wf_v<%=index%>_0' onChange='wfFilter.fieldChanged(this)' value='<%=container.sanitized_value(0)%>'>
    </td>
		<td width='1%'>
      <%= link_to_function(image_tag('wf/images/clock.png', :border => 0, :class => 'wf_calendar_trigger', :style => 'vertical-align:top;', :title => 'select start date & time'), "wfCalendar.selectDateTime('wf_v#{index}_0', this)") %>
    </td>
    <td width='49%'>
      <input type='text' style='width:99%;' class='wf_input' name='wf_v<%=index%>_1' id='wf_v<%=index%>_1' onChange='wfFilter.fieldChanged(this)' value='<%=container.sanitized_value(1)%>'>
    </td>
    <td width='1%'>
      <%= link_to_function(image_tag('wf/images/clock.png', :border => 0, :class => 'wf_calendar_trigger', :style => 'vertical-align:top;', :title => 'select end date & time'), "wfCalendar.selectDateTime('wf_v#{index}_1', this)") %>
    </td>
	</tr>
</table>
