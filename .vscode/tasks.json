{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "analyze file",
      "type": "shell",
      "command": "ruby -c ${file}",
      "presentation": {
        "clear": true
      }
    },{
      "label": "run all tests in file",
      "group": "test",
      "type": "shell",
      "command": "bundle exec ${workspaceFolder}/bin/test ${file} 2>&1 | tee ${fileBasenameNoExtension}.out",
      "problemMatcher": [],
      "presentation": {
        "clear": true
      }
    },{
      "label": "run current test in file",
      "group": "test",
      "type": "shell",
      "command": "bundle exec ${workspaceFolder}/bin/test ${file}:${lineNumber}",
      "problemMatcher": [],
      "presentation": {
        "clear": true
      }
    },
  ]
}
